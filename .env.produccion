# ============================================================
#  .env de PRODUCCION. NO es el que usa tu maquina.
#
#  Como usarlo en el VPS:
#    1. Copia este archivo a APP_DIR/.env  (sobreescribe el de desarrollo)
#    2. Genera una SECRET_KEY nueva:      openssl rand -base64 48
#    3. Pegala en la linea de abajo
#    4. Rellena EMAIL_HOST_PASSWORD con la clave de aplicacion de Gmail
#
#  Este archivo NO lleva secretos de verdad a proposito: son marcadores.
#  El .env que estas editando en local (DEBUG=True) no se sube.
# ============================================================

# OBLIGATORIO: generar en el VPS con `openssl rand -base64 48`.
# La clave que venia en el paquete de la USB fue creada para otra maquina y
# Django invalida todas las sesiones y cookies firmadas si se cambia.
SECRET_KEY=CAMBIAR_POR_UNA_GENERADA_EN_EL_VPS

# False en produccion. Con True, Django muestra paginas de error con el
# traceback completo y el panel de detalle a cualquiera que entre.
DEBUG=False

# El dominio real, sin esquema ni puerto. El puerto 5137 queda detras del
# nginx del host, asi que Django nunca lo ve.
ALLOWED_HOSTS=megas.com.co,www.megas.com.co

# Esquema + dominio + puerto, como los exige Django 4+.
CSRF_TRUSTED_ORIGINS=https://megas.com.co,https://www.megas.com.co

# Vacio a proposito: el frontend usa rutas relativas y nunca cruza origenes.
# Solo rellenalo si algun dia sirves el frontend desde otro dominio.
CORS_ALLOWED_ORIGINS=

# Gmail para los correos (certificados, avisos). ROTALA en Google Account >
# Seguridad > Contrasenias de aplicacion; la clave anterior quedo expuesta en
# el historial de git de core_project/settings.py.
EMAIL_HOST_USER=megaspublicidad@gmail.com
EMAIL_HOST_PASSWORD=


#esta es la contraseña de aplicacion que se genera en google cada vez que se cambia la contraseña principal de la cuenta, si se cambia la contraseña principal 
#EMAIL_HOST_PASSWORD=iwjokepkwaigsinj

