# ============================================================
#  .env de PRODUCCION (plantilla). NO es el que usa tu maquina.
#
#  Como usarlo en el VPS:
#    1. Copia este archivo a /root/induccion-megas/.env  (sobreescribe el de desarrollo)
#    2. Genera una SECRET_KEY nueva:      openssl rand -base64 48
#    3. Rellena los valores marcados con CAMBIAR_*
#    4. chmod 600 .env
#
#  Este archivo NO lleva secretos de verdad: son marcadores.
#  El .env real del VPS nunca se sube a git.
#
#  AVISO: la contrasena de aplicacion de Gmail que antes estaba escrita
#  en este archivo quedo expuesta en el historial de git. Hay que
#  REVOCARLA en Google > Seguridad > Contrasenas de aplicacion y generar
#  una nueva. La nueva va SOLO en el .env del VPS.
# ============================================================

# OBLIGATORIO: generar en el VPS con `openssl rand -base64 48`.
# La clave de desarrollo fue creada para otra maquina; reutilizarla en
# produccion invalida sesiones y expone la firma de cookies.
SECRET_KEY=CAMBIAR_POR_UNA_GENERADA_EN_EL_VPS

# False en produccion. Con True, Django muestra paginas de error con el
# traceback completo a cualquiera que entre.
DEBUG=False

# El dominio real, sin esquema ni puerto. Sin IPs ni localhost.
ALLOWED_HOSTS=megas.com.co,www.megas.com.co

# Esquema + dominio, como lo exige Django 4+.
CSRF_TRUSTED_ORIGINS=https://megas.com.co,https://www.megas.com.co

# Vacio a proposito: el frontend usa rutas relativas y nunca cruza
# origenes. Solo rellenarlo si el frontend se sirve desde otro dominio.
CORS_ALLOWED_ORIGINS=

# Gmail para los correos (aviso de aprobacion y certificado).
# IMPORTANTE: EMAIL_HOST_USER debe ser la MISMA cuenta de Google que
# genero la contrasena de aplicacion. Una clave de la cuenta A con el
# usuario de la cuenta B devuelve error 535.
EMAIL_HOST_USER=CAMBIAR_POR_LA_CUENTA_GMAIL_OFICIAL
# Contrasena de APLICACION (16 letras), generada en Google > Seguridad >
# Verificacion en dos pasos > Contrasenas de aplicacion. Pegar sin
# espacios. La contrasena normal de la cuenta devuelve 530/535.
EMAIL_HOST_PASSWORD=CAMBIAR_POR_CONTRASENA_DE_APLICACION_GMAIL

# A quien llega el aviso de aprobacion de un curso y el certificado (CSV).
# Sin esto, los avisos fallan con "NOTIF_DESTINATARIOS esta vacio".
NOTIF_DESTINATARIOS=CAMBIAR_POR_CORREO_INTERNO

# Recordatorio fuera de este archivo (no es variable de entorno):
# en Firebase Console > Authentication > Authorized domains hay que
# agregar megas.com.co, o el login falla SOLO en produccion.
